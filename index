 
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YOBO Factory | UMKM Pekanbaru</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        html {
            scroll-behavior: smooth;
        }
    </style>
</head>

<body class="bg-slate-50 text-gray-800">

    <!-- NAVBAR -->
    <nav class="bg-white shadow-md">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">

            <h1 class="text-2xl font-bold text-blue-700">
                YOBO<span class="text-sky-400">Factory.</span>
            </h1>

            <div class="hidden md:flex items-center gap-8">
                <a href="#home" class="hover:text-blue-600">Home</a>
                <a href="#about" class="hover:text-blue-600">Tentang</a>
                <a href="#produk" class="hover:text-blue-600">Produk</a>
                <a href="#kontak" class="hover:text-blue-600">Kontak</a>
            </div>

            <a href="#kontak"
               class="bg-blue-600 text-white px-5 py-2 rounded-lg
               hover:bg-blue-700 transition">
                Login
            </a>

        </div>
    </nav>


    <!-- HERO SECTION -->
    <section id="home"
        class="min-h-[80vh] flex items-center bg-gradient-to-r
        from-blue-700 to-sky-500 text-white">

        <div class="max-w-7xl mx-auto px-6 py-20">

            <div class="max-w-2xl">

                <span class="bg-white/20 px-4 py-2 rounded-full
                text-sm font-medium">
                    UMKM Lokal Pekanbaru
                </span>

                <h2 class="text-4xl md:text-6xl font-bold mt-6 leading-tight">
                    Kenali Produk
                    <span class="text-sky-200">YOBO Factory</span>
                </h2>

                <p class="text-lg text-blue-50 mt-6 leading-relaxed">
                    YOBO Factory hadir sebagai bagian dari kreativitas
                    UMKM lokal dengan menghadirkan produk berkualitas,
                    inovatif, dan menarik bagi masyarakat.
                </p>

                <div class="flex flex-wrap gap-4 mt-8">

                    <a href="#produk"
                       class="bg-white text-blue-700 px-7 py-3
                       rounded-lg font-semibold hover:bg-blue-100
                       transition">
                        Lihat Produk
                    </a>

                    <a href="#kontak"
                       class="border-2 border-white px-7 py-3
                       rounded-lg font-semibold hover:bg-white
                       hover:text-blue-700 transition">
                        Hubungi Kami
                    </a>

                </div>

            </div>

        </div>
    </section>


    <!-- ABOUT SECTION -->
    <section id="about" class="py-20 px-6">
        <div class="max-w-5xl mx-auto text-center">

            <h2 class="text-3xl font-bold text-blue-700">
                Tentang YOBO Factory
            </h2>

            <p class="text-gray-600 mt-5 leading-relaxed">
                YOBO Factory merupakan UMKM yang menjadi bagian
                dari perkembangan usaha lokal. Melalui kreativitas
                dan inovasi, YOBO Factory berupaya menghadirkan
                produk yang dapat dikenal dan diminati masyarakat.
            </p>

        </div>
    </section>


    <!-- PRODUK SECTION -->
    <section id="produk" class="bg-blue-50 py-20 px-6">

        <div class="max-w-7xl mx-auto text-center">

            <h2 class="text-3xl font-bold text-blue-700">
                Produk Kami
            </h2>

            <p class="text-gray-600 mt-3">
                Temukan berbagai produk dari YOBO Factory.
            </p>

            <div class="mt-10 grid md:grid-cols-3 gap-8">

                <div class="bg-white p-8 rounded-xl shadow-sm">
                    <div class="text-4xl mb-4">🏭</div>
                    <h3 class="font-bold text-xl text-blue-700">
                        Produk Berkualitas
                    </h3>
                    <p class="text-gray-600 mt-3">
                        Mengutamakan kualitas dalam setiap produk.
                    </p>
                </div>

                <div class="bg-white p-8 rounded-xl shadow-sm">
                    <div class="text-4xl mb-4">💡</div>
                    <h3 class="font-bold text-xl text-blue-700">
                        Kreatif & Inovatif
                    </h3>
                    <p class="text-gray-600 mt-3">
                        Mengembangkan ide kreatif dalam dunia usaha.
                    </p>
                </div>

                <div class="bg-white p-8 rounded-xl shadow-sm">
                    <div class="text-4xl mb-4">🤝</div>
                    <h3 class="font-bold text-xl text-blue-700">
                        Mendukung UMKM
                    </h3>
                    <p class="text-gray-600 mt-3">
                        Mendukung perkembangan usaha lokal.
                    </p>
                </div>

            </div>

        </div>
    </section>


    <!-- FOOTER -->
    <footer id="kontak" class="bg-blue-950 text-white py-8">

        <div class="max-w-7xl mx-auto px-6 text-center">

            <h2 class="text-2xl font-bold">
                YOBO Factory
            </h2>

            <p class="text-blue-200 mt-2">
                Kreativitas Lokal, Kualitas Terbaik.
            </p>

            <p class="text-sm text-blue-300 mt-6">
                © 2026 YOBO Factory. All Rights Reserved.
            </p>

        </div>

    </footer>

</body>
</html>
